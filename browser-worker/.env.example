# Private local browser worker only. This file is a template; NEVER commit .env with secrets.
BROWSER_WORKER_TOKEN=
VNC_PASSWORD=

# Optional additional restriction: if populated, AI may act only on these HTTPS
# domains. The worker always pins actions to the EXACT currently selected tab
# and origin, even if this list is empty. Manual browsing remains unrestricted.
BROWSER_AGENT_DOMAINS=

# Enables scoped, bounded non-submit actions on the tab manually chosen by
# the user. scripts/windows/setup.ps1 sets this to false on first local setup.
# The hosted Lovable preview cannot start or access a local browser.
BROWSER_ENABLE_READONLY_AGENT=false
