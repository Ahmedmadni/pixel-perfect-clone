{
  "name": "paw-runtime",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Local runtime for Personal AI Workspace. Binds to 127.0.0.1 only.",
  "engines": { "node": ">=22" },
  "scripts": {
    "token": "tsx scripts/gen-token.ts",
    "migrate": "tsx src/migrate.ts",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
