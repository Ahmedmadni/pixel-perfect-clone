# Copy to runtime/.env (gitignored) — or run `npm run token`, which creates it.
# Never commit real values.
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=4100
# Generated by `npm run token` (64 hex chars). Leave empty here.
RUNTIME_TOKEN=
DATABASE_URL=postgres://paw:CHANGE_ME@127.0.0.1:5432/paw
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
